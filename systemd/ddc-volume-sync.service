[Unit]
Description=Display Audio hardware volume bridge
Documentation=https://github.com/satorusaka/noctalia-ddc-volume
After=pipewire.service wireplumber.service
ConditionFileIsExecutable=%h/.local/bin/ddc-volume-daemon

[Service]
Type=simple
EnvironmentFile=%h/.config/ddc-volume-control/environment
ExecStart=%h/.local/bin/ddc-volume-daemon daemon --display-serial ${DDC_DISPLAY_SERIAL} --monitor-sink ${DDC_MONITOR_SINK} --bus ${DDC_BUS} --poll-ms ${DDC_POLL_MS}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
